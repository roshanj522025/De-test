{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "privileged": true,
  "forwardPorts": [5900],
  "portsAttributes": {
    "5900": {
      "label": "TigerVNC",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "runArgs": ["--cap-add=SYS_ADMIN"],
  "postCreateCommand": "mkdir -p ~/.vnc && printf 'password\\n' | tigervncpasswd -f > ~/.vnc/passwd && chmod 600 ~/.vnc/passwd",
  "postStartCommand": "tigervncserver -xstartup \"xfce4-session\" -rfbport 5900"
}
